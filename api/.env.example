# Copiar este arquivo para .env e preencher com os valores reais.
# O .env nao deve ser commitado no git.

DATABASE_URL=
JWT_SECRET_KEY=
JWT_ALGORITHM=
JWT_EXPIRE_HOURS=

# Origens permitidas no CORS, separadas por virgula. Opcional: se vazio ou ausente,
# usa a lista padrao do codigo (VM de producao e dev local).
# Exemplo: CORS_ORIGINS=http://localhost:8080,http://10.148.53.111:8080
CORS_ORIGINS=
